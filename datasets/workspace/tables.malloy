// Row sources. Joins go to enriched sources only where the target has no joins of its own (no cycles).
source: clients is raw_clients

source: notes is raw_notes extend {
  join_one: task_link is raw_tasks_notes on id = task_link.to_id
  join_one: task is raw_tasks on task_link.from_id = task.id
}

source: sections is raw_sections extend {
  join_one: project_link is raw_projects_sections on id = project_link.to_id
  join_one: project is raw_projects on project_link.from_id = project.id
}

source: roles is raw_roles

source: task_statuses is raw_task_statuses

source: teams is raw_teams

source: users is raw_users extend {
  join_one: client is clients on client_id = client.id
  join_one: report_to is raw_users on report_to_id = report_to.id
}

source: companies is raw_companies extend {
  join_one: owner is raw_users on owner_id = owner.id
}

source: comments is raw_comments extend {
  join_one: user is raw_users on user_id_2 = user.id
}

source: projects is raw_projects extend {
  join_one: owner is raw_users on owner_id = owner.id
}

source: tasks is raw_tasks extend {
  join_one: assignee is raw_users on assignee_id = assignee.id
  join_one: when_ is task_statuses on when_id = when_.id
  join_one: section is sections on section_id = section.id
  join_one: assigner is raw_users on assigner_id = assigner.id
  join_one: top_level_task is raw_tasks on top_level_task_id = top_level_task.id
  join_one: in_note is notes on in_note_id = in_note.id
}

source: task_dependencies is raw_task_dependencies extend {
  join_one: predecessor is raw_tasks on predecessor_id = predecessor.id
  join_one: task is raw_tasks on task_id = task.id
}

source: time_entries is raw_time_entries extend {
  join_one: project_ is raw_projects on project_id = project_.id
  join_one: task is raw_tasks on task_id = task.id
  join_one: byuser is raw_users on byuser_id = byuser.id
}


// Link tables for one-to-many (Type 9) and many-to-many (Type 8) columns.
#" many-to-many or non-unique link: users "Roles" -> roles (B_User_244_47793). from_id is the users row, to_id the roles row.
source: raw_users_roles is rds.table("B_User_244_47793") extend {
  dimension:
    from_id is `FromId`
    to_id is `ToId`
    created is `Created`
  measure:
    row_count is count()
}
source: users_roles is raw_users_roles extend {
  join_one: user is raw_users on from_id = user.id
  join_one: role is raw_roles on to_id = role.id
}

#" many-to-many or non-unique link: users "Users" -> users (B_User_244_47821). from_id is the users row, to_id the users row.
